{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "LS-Text default capabilities",
  "windows": ["main", "doc-*"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:webview:allow-create-webview-window",
    "dialog:default",
    "store:default",
    "shell:allow-open",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    {
      "identifier": "fs:default",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$APPDATA/**" },
        { "path": "$APPCONFIG/**" },
        { "path": "$APPCACHE/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$TEMP/**" }
      ]
    },
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-copy-file"
  ]
}
