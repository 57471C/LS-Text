{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LS.Text",
  "version": "0.1.4",
  "identifier": "com.leanstudio.lstext",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LS.Text",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#1f1f1f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Fast scratchpad editor from Lean.Studio",
    "longDescription": "LS.Text is a local-first scratchpad and micro-editor. Instant boot, CodeMirror 6, optional folder tree and terminal launcher. Open source (MIT) supporting tool in the Lean.Studio suite.",
    "fileAssociations": [
      {
        "ext": ["txt", "text", "log"],
        "name": "Plain Text",
        "description": "Plain text document",
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["json", "jsonc"],
        "name": "JSON",
        "mimeType": "application/json",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["py", "ts", "tsx", "js", "jsx", "rs", "toml", "yaml", "yml", "css", "html", "env"],
        "name": "Source Text",
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzNzkwRjY2MkEzMjU0MTUKUldRVlZESXFaZzk1RTdzenlxbHVsVkQrd0NIdUdzOHh3STBkOTNOUHk3Y0hEdU5rNWtjU0M2RHEK",
      "endpoints": [
        "https://lean.studio/lstext/latest.json",
        "https://github.com/57471C/LS-Text/releases/latest/download/latest.json"
      ]
    }
  }
}
